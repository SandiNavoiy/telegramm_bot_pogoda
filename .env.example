# Токен вашего Telegram бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# API ключ OpenWeatherMap (получить на https://openweathermap.org/api)
# Если ключ не указан, бот автоматически переключится на бесплатный Open-Meteo API без ключа!
OPENWEATHER_API_KEY=

# Часовой пояс по умолчанию для расписаний (например: Europe/Moscow, Asia/Yekaterinburg, UTC)
TIMEZONE=Europe/Moscow

# Время отправки утреннего прогноза (часы и минуты)
MORNING_NOTIFICATION_HOUR=7
MORNING_NOTIFICATION_MINUTE=0

# Время проверки осадков на остаток дня (часы и минуты)
AFTERNOON_CHECK_HOUR=14
AFTERNOON_CHECK_MINUTE=0

# Путь к файлу базы данных SQLite
DATABASE_PATH=weather_bot.db
